<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/player_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="16dp"
        android:paddingRight="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_back"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusRight="@+id/player_settings"
                android:nextFocusDown="@+id/player_play"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Zurück"
                android:textColor="@color/muted"
                android:textSize="16sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:focusable="false"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:focusable="false"
                android:src="@drawable/ic_logo"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:focusable="false"/>

            <ImageButton
                android:id="@+id/player_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_settings_focus"
                android:clickable="true"
                android:contentDescription="Einstellungen"
                android:focusable="true"
                android:nextFocusLeft="@+id/player_back"
                android:nextFocusRight="@+id/player_fav"
                android:nextFocusDown="@+id/player_play"
                android:padding="12dp"
                android:src="@drawable/ic_gear"/>

            <TextView
                android:id="@+id/player_fav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_player_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/player_settings"
                android:nextFocusDown="@+id/player_play"
                android:text="☆"
                android:textColor="@color/paper"
                android:textSize="22sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/player_art"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:contentDescription="@null"
            android:focusable="false"
            android:scaleType="centerCrop"/>

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:focusable="false"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="2"
            android:text="Kein Sender"
            android:textColor="@color/paper"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/player_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:focusable="false"
            android:gravity="center"
            android:maxLines="2"
            android:text="Wähle einen Sender"
            android:textColor="#E8C27A"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/player_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:focusable="false"
            android:gravity="center"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/player_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:letterSpacing="0.14"
            android:text="LIVE"
            android:textColor="#E8C27A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/player_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:focusable="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_prev"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_player_btn"
                android:clickable="true"
                android:contentDescription="Vorheriger Sender"
                android:focusable="true"
                android:nextFocusRight="@+id/player_play"
                android:nextFocusUp="@+id/player_fav"
                android:nextFocusDown="@+id/sleep_aus"
                android:padding="16dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/paper"/>

            <ImageButton
                android:id="@+id/player_play"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_play_focus"
                android:clickable="true"
                android:contentDescription="Play Pause"
                android:focusable="true"
                android:nextFocusLeft="@+id/player_prev"
                android:nextFocusRight="@+id/player_next"
                android:nextFocusUp="@+id/player_fav"
                android:nextFocusDown="@+id/sleep_aus"
                android:padding="22dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/ink"/>

            <ImageButton
                android:id="@+id/player_next"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_player_btn"
                android:clickable="true"
                android:contentDescription="Nächster Sender"
                android:focusable="true"
                android:nextFocusLeft="@+id/player_play"
                android:nextFocusUp="@+id/player_fav"
                android:nextFocusDown="@+id/sleep_aus"
                android:padding="16dp"
                android:src="@android:drawable/ic_media_next"
                android:tint="@color/paper"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:focusable="false"
            android:letterSpacing="0.08"
            android:text="SCHLAF-TIMER"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sleep_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sleep_aus"
                    style="@style/PlayerChip"
                    android:nextFocusLeft="@+id/sleep_90"
                    android:nextFocusRight="@+id/sleep_15"
                    android:nextFocusUp="@+id/player_play"
                    android:nextFocusDown="@+id/vol_down"
                    android:text="Aus"/>

                <TextView
                    android:id="@+id/sleep_15"
                    style="@style/PlayerChip"
                    android:nextFocusLeft="@+id/sleep_aus"
                    android:nextFocusRight="@+id/sleep_30"
                    android:nextFocusUp="@+id/player_play"
                    android:nextFocusDown="@+id/vol_down"
                    android:text="15"/>

                <TextView
                    android:id="@+id/sleep_30"
                    style="@style/PlayerChip"
                    android:nextFocusLeft="@+id/sleep_15"
                    android:nextFocusRight="@+id/sleep_45"
                    android:nextFocusUp="@+id/player_play"
                    android:nextFocusDown="@+id/vol_down"
                    android:text="30"/>

                <TextView
                    android:id="@+id/sleep_45"
                    style="@style/PlayerChip"
                    android:nextFocusLeft="@+id/sleep_30"
                    android:nextFocusRight="@+id/sleep_60"
                    android:nextFocusUp="@+id/player_play"
                    android:nextFocusDown="@+id/vol_down"
                    android:text="45"/>

                <TextView
                    android:id="@+id/sleep_60"
                    style="@style/PlayerChip"
                    android:nextFocusLeft="@+id/sleep_45"
                    android:nextFocusRight="@+id/sleep_90"
                    android:nextFocusUp="@+id/player_play"
                    android:nextFocusDown="@+id/vol_down"
                    android:text="60"/>

                <TextView
                    android:id="@+id/sleep_90"
                    style="@style/PlayerChip"
                    android:nextFocusLeft="@+id/sleep_60"
                    android:nextFocusRight="@+id/sleep_aus"
                    android:nextFocusUp="@+id/player_play"
                    android:nextFocusDown="@+id/vol_down"
                    android:text="90"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/sleep_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:focusable="false"
            android:textColor="@color/muted"
            android:textSize="13sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:focusable="false"
            android:letterSpacing="0.08"
            android:text="LAUTSTÄRKE"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vol_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusRight="@+id/vol_seek"
                android:nextFocusUp="@+id/sleep_aus"
                android:nextFocusDown="@+id/vol_down"
                android:text="−"
                android:textColor="@color/paper"
                android:textSize="24sp"/>

            <SeekBar
                android:id="@+id/vol_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:focusable="true"
                android:max="100"
                android:nextFocusLeft="@+id/vol_down"
                android:nextFocusRight="@+id/vol_up"
                android:nextFocusUp="@+id/sleep_aus"
                android:nextFocusDown="@+id/vol_seek"
                android:progress="100"/>

            <TextView
                android:id="@+id/vol_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_player_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/vol_seek"
                android:nextFocusUp="@+id/sleep_aus"
                android:nextFocusDown="@+id/vol_up"
                android:text="+"
                android:textColor="@color/paper"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/vol_label"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center"
                android:text="100 %"
                android:textColor="@color/paper"
                android:textSize="16sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/vol_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:focusable="false"
            android:gravity="center"
            android:text="TV: Systemlautstärke auch mit ▲/▼ der Fernbedienung"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/player_tv_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="false"
            android:gravity="center"
            android:text="OK: Aktion · Zurück: zur Liste (Wiedergabe läuft weiter)"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
