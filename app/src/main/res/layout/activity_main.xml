<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tv_rail"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/tv_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/app_name"
                android:focusable="false"
                android:src="@drawable/ic_logo"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/app_name"
                    android:focusable="false"
                    android:src="@drawable/ic_logo"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:focusable="false">

                    <TextView
                        android:id="@+id/brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.04"
                        android:text="RADIO"
                        android:textColor="@color/paper"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:focusable="false"/>

                    <TextView
                        android:id="@+id/brand_welt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.08"
                        android:text="WELT"
                        android:textColor="#E8C27A"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:focusable="false"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:nextFocusLeft="@+id/settings"
                    android:nextFocusRight="@+id/settings"
                    android:nextFocusDown="@+id/tab_discover"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:singleLine="true"
                    android:textColor="@color/paper"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp"/>

                <ImageButton
                    android:id="@+id/settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_settings_focus"
                    android:clickable="true"
                    android:contentDescription="Einstellungen"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/search"
                    android:nextFocusRight="@+id/search"
                    android:nextFocusDown="@+id/tab_favorites"
                    android:padding="10dp"
                    android:src="@drawable/ic_gear"/>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/tabs_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:orientation="horizontal"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tab_discover"
                        style="@style/TabChip"
                        android:nextFocusLeft="@+id/tab_favorites"
                        android:nextFocusRight="@+id/tab_countries"
                        android:nextFocusUp="@+id/search"
                        android:nextFocusDown="@+id/list"
                        android:text="Entdecken"/>

                    <TextView
                        android:id="@+id/tab_countries"
                        style="@style/TabChip"
                        android:nextFocusLeft="@+id/tab_discover"
                        android:nextFocusRight="@+id/tab_languages"
                        android:nextFocusUp="@+id/search"
                        android:nextFocusDown="@+id/list"
                        android:text="Länder"/>

                    <TextView
                        android:id="@+id/tab_languages"
                        style="@style/TabChip"
                        android:nextFocusLeft="@+id/tab_countries"
                        android:nextFocusRight="@+id/tab_genres"
                        android:nextFocusUp="@+id/search"
                        android:nextFocusDown="@+id/list"
                        android:text="Sprachen"/>

                    <TextView
                        android:id="@+id/tab_genres"
                        style="@style/TabChip"
                        android:nextFocusLeft="@+id/tab_languages"
                        android:nextFocusRight="@+id/tab_favorites"
                        android:nextFocusUp="@+id/search"
                        android:nextFocusDown="@+id/list"
                        android:text="Genres"/>

                    <TextView
                        android:id="@+id/tab_favorites"
                        style="@style/TabChip"
                        android:nextFocusLeft="@+id/tab_genres"
                        android:nextFocusRight="@+id/tab_discover"
                        android:nextFocusUp="@+id/settings"
                        android:nextFocusDown="@+id/list"
                        android:text="Favoriten"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/update_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_update_bar"
                android:clickable="true"
                android:descendantFocusability="afterDescendants"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusUp="@+id/tab_discover"
                android:nextFocusDown="@+id/list"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/update_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:text="Neue Version verfügbar"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/update_go"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_update_go"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusUp="@+id/tab_discover"
                    android:nextFocusDown="@+id/list"
                    android:paddingLeft="12dp"
                    android:paddingTop="8dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="8dp"
                    android:text="Jetzt laden"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/discover_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/continue_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:paddingBottom="8dp"
                    android:text="WEITERHÖREN"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/continue_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/continue_art"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@null"
                        android:focusable="false"
                        android:scaleType="centerCrop"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/continue_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/paper"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/continue_meta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingTop="2dp"
                            android:textColor="@color/muted"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/continue_track"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingTop="2dp"
                            android:textColor="#E8C27A"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/continue_play"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_play_focus"
                        android:contentDescription="Weiterhören"
                        android:focusable="true"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_media_play"
                        android:tint="@color/ink"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/genre_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.08"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:text="GENRES"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/genre_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:descendantFocusability="afterDescendants"
                    android:divider="@color/line"
                    android:dividerHeight="0dp"
                    android:focusable="true"
                    android:nextFocusUp="@+id/tab_discover"
                    android:nextFocusDown="@+id/play"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>

                <TextView
                    android:id="@+id/empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:gravity="center"
                    android:padding="32dp"
                    android:textColor="@color/muted"
                    android:textSize="16sp"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/busy"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:indeterminate="true"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="center"
                android:padding="8dp"
                android:text="OK: Abspielen · OK halten: Favorit · ←: Menü · →: Inhalt · ↑ an der Liste: Genres"
                android:textSize="12sp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/player"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/surface"
                android:focusable="false"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="8dp">

                <ImageView
                    android:id="@+id/now_art"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:nextFocusRight="@+id/play"
                    android:nextFocusUp="@+id/list"
                    android:scaleType="centerCrop"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/now_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:maxLines="1"
                        android:nextFocusLeft="@+id/now_art"
                        android:nextFocusRight="@+id/play"
                        android:text="Kein Sender"
                        android:textColor="@color/paper"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/now_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="1"
                        android:text="Wähle einen Sender zum Hören"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/play"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_play_focus"
                    android:clickable="true"
                    android:contentDescription="Play"
                    android:focusable="true"
                    android:nextFocusLeft="@+id/now_art"
                    android:nextFocusRight="@+id/settings"
                    android:nextFocusUp="@+id/list"
                    android:nextFocusDown="@+id/play"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/ink"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
