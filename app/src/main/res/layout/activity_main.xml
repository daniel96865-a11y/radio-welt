<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@color/ink"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="italic"
            android:textColor="@color/paper"
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="serif"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/paper"
            android:textColorHint="@color/muted"
            android:id="@+id/search"
            android:background="@drawable/bg_search"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/search_hint"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_marginStart="12dp"/>
        <ImageButton
            android:id="@+id/settings"
            android:background="@android:color/transparent"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_gear"
            android:contentDescription="Einstellungen"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/tabs"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView android:id="@+id/tab_discover" android:text="@string/tab_discover" style="@style/TabChip"/>
            <TextView android:id="@+id/tab_countries" android:text="@string/tab_countries" style="@style/TabChip"/>
            <TextView android:id="@+id/tab_languages" android:text="@string/tab_languages" style="@style/TabChip"/>
            <TextView android:id="@+id/tab_favorites" android:text="@string/tab_favorites" style="@style/TabChip"/>
            <TextView android:id="@+id/tab_updates" android:text="@string/tab_updates" style="@style/TabChip"/>
        </LinearLayout>
    </HorizontalScrollView>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/line"
            android:dividerHeight="1dp"/>
        <ScrollView
            android:id="@+id/updates_scroll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/updates_container"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/empty"
            android:padding="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/busy"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="true"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/player"
        android:background="@color/surface"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="72dp">
        <ImageView
            android:id="@+id/now_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:layout_marginEnd="12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/paper"
                android:ellipsize="end"
                android:id="@+id/now_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kein Sender"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:ellipsize="end"
                android:id="@+id/now_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wähle einen Sender zum Hören"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/play"
            android:background="@drawable/bg_play"
            android:padding="12dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/ink"
            android:contentDescription="Play"/>
    </LinearLayout>
</LinearLayout>
