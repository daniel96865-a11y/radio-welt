<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TabChip">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>
    <style name="Theme.Welle" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:textColorPrimary">@color/paper</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:editTextColor">@color/paper</item>
        <item name="android:colorControlActivated">@color/paper</item>
        <item name="android:colorPrimary">@color/paper</item>
        <item name="android:colorAccent">@color/paper</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
